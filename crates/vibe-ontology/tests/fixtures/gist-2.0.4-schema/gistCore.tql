attribute actualEndDate value datetime;
attribute actualEndDateTime value datetime;
attribute actualEndMicrosecond value datetime;
attribute actualEndMinute value datetime;
attribute actualEndYear value datetime;
attribute actualStartDate value datetime;
attribute actualStartDateTime value datetime;
attribute actualStartMicrosecond value datetime;
attribute actualStartMinute value datetime;
attribute actualStartYear value datetime;
attribute atDateTime value datetime;
attribute birthDate value datetime;
attribute containedText value string;
attribute conversionFactor value double;
attribute conversionOffset value double;
