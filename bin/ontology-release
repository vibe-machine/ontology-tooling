#!/usr/bin/env bash
# Stable cross-repo entrypoint for the ontology release flow.
# Consumer repos call `../ontology-tooling/bin/ontology-release --repo . [...]`
# from their package.json `release`/`release:check` scripts. This shim delegates
# to the compiled `ont` CLI, exposed next to it at bin/ont by `mise run build-ont`.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT_DIR/bin/ont"

if [[ ! -x "$BIN" ]]; then
  echo "ont: bin/ont is missing or stale — build it first:" >&2
  echo "     (cd $ROOT_DIR && mise run build-ont)   # or: cargo build --release -p ont" >&2
  exit 1
fi

exec "$BIN" release "$@"
